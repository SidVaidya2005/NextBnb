# NextBnb environment variables — copy to .env.local and fill in.
# Full reference: context/code-standards.md → Environment Variables.
# NEXT_PUBLIC_* are exposed to the browser; the rest are server-only secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server-only (seed/admin scripts). Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# OAuth redirectTo base: http://localhost:3000 in dev, the Render URL in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Public twin of the above: CldUploadWidget needs the api_key in the browser to
# perform a signed upload. The api_key is a public identifier, not a secret —
# the SECRET below is what authorises the upload, and it never leaves the server.
NEXT_PUBLIC_CLOUDINARY_API_KEY=
# Secret — server-only (signs uploads). Never expose.
CLOUDINARY_API_SECRET=
